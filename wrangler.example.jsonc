{
  "name": "codex-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/15 * * * *", "30 2 * * *", "30 14 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-monitor-db",
      "database_id": "replace-with-your-d1-database-id"
    }
  ],
  // The bucket remains private. Use a separate staging bucket and database;
  // never point local development at production resources.
  "r2_buckets": [
    {
      "binding": "GAMBIT_SNAPSHOTS",
      "bucket_name": "replace-with-staging-gambit-snapshots",
      "preview_bucket_name": "replace-with-local-gambit-snapshots"
    }
  ],
  // Future Cloudflare Workflow binding shape. The class is implemented in
  // src/open-gambit/workflow-entrypoint.ts; creating the production Workflow is a
  // deliberate post-review action and is not performed by this repository.
  "workflows": [
    {
      "binding": "GAMBIT_ANALYSIS_WORKFLOW",
      "name": "gambit-analysis",
      "class_name": "OpenGambitAnalysisWorkflow"
    }
  ],
  "vars": {
    "LLM_BASE_URL": "https://api.openai.com/v1",
    "LLM_MODEL": "gpt-4o-mini",
    "LLM_MAX_TOKENS": "2000",
    "MONITORED_ACCOUNTS": "thsottiaux",
    "SITE_URL": "https://example.com",
    "SITE_NAME": "Tibo Codex Monitor",
    "GOOGLE_ANALYTICS_ID": "",
    "GOOGLE_SITE_VERIFICATION": "",
    "TELEGRAM_ADMIN_USER_ID": "",
    "X_API_AUTOMATIC_SYNC": "true",
    "X_API_USER_ID": "",
    "X_API_POLL_INTERVAL_MINUTES": "15",
    "X_API_STALE_AFTER_MINUTES": "30",
    "X_API_MAX_SYNC_ATTEMPTS_PER_DAY": "96",
    "X_API_MAX_PAGES_PER_SYNC": "3",
    "X_API_MAX_RESULTS_PER_PAGE": "100",
    "WEB_SEARCH_ENABLED": "false",
    "MAX_WEB_SEARCH_REQUESTS_PER_DAY": "6",
    "NORMAL_SEARCH_INTERVAL_HOURS": "4",
    // Optional knobs (code defaults apply when unset):
    //   WEB_SEARCH_ACTIVE_MODE_DAILY_LIMIT: active reset modes (WATCHING /
    //     CONFIRMING) draw on this larger pool (default 24/day) instead of the
    //     NORMAL 6 so hourly confirmation searches are not exhausted after a
    //     few hours.
    //   WEB_SEARCH_SUPPLEMENT_INTERVAL_HOURS: cooldown (default 1h) for the
    //     reply-supplement search that backstops the direct X timeline.
    //   WEB_SEARCH_SUPPLEMENT_DAILY_LIMIT: separate small pool for the reply
    //     supplement (default 2/day), so NORMAL totals 6 discovery + up to 2
    //     supplement searches per day and one channel cannot exhaust the other.
    //   WEB_SEARCH_SUPPLEMENT_NORMAL_STALE_HOURS: in NORMAL mode the supplement
    //     also fires when the last regular search is older than this (default 2h)
    //     or when a direct X reset signal was ingested without an event.
    //   CLASSIFICATIONS_PER_RUN: per-run classifier budget (default/hard cap 8; 0 disables).
    //   REVIEW_ALERT_AFTER_HOURS: queue age alert threshold (default 6h).
    //   REVIEW_ALERT_PROVIDER_STATUS: true opts into provider status alerts;
    //     default only stores review_queue_alert in settings, no Telegram sends.
    //   MONITOR_RUN_WARN_MS: wall-time alert threshold (default 240000ms).
    //   X_API_BACKFILL_MAX_PAGES: page depth for the one-shot /__cron/backfill-x
    //     historical backfill (default 5; the whole run costs one X reservation).
    //   X_BACKFILL_MAX_LOOKBACK_DAYS: oldest allowed `since` bound for backfill
    //     without force=true (default 14).
    //   RELEASE CHECK REQUIRED: explicitly set X_INGESTION_PROBE_ENABLED=true
    //     in an authorized deployment; health warns while disabled.
    //   X_INGESTION_PROBE_ENABLED: opt-in completeness probe ('true'). Compares
    //     the raw recent timeline (replies included) against stored posts once
    //     per X_INGESTION_PROBE_INTERVAL_HOURS (default 24) and reports
    //     missedCount via /api/health ingestionGap. Consumes one X reservation;
    //     never writes source_posts and never advances any cursor.
    //   X_INGESTION_PROBE_WINDOW_HOURS / X_INGESTION_PROBE_MAX_PAGES /
    //     X_INGESTION_PROBE_RETRY_HOURS: probe window (24h), page depth (2) and
    //     failure retry backoff (4h).
    "BRAVE_SEARCH_PRICE_PER_1000_USD": "5",
    "BRAVE_MONTHLY_CREDIT_USD": "5",
    "COMMUNITY_POSTING_ENABLED": "false",
    "COMMUNITY_MAX_CONTENT_LENGTH": "2000",
    "COMMUNITY_MAX_NICKNAME_LENGTH": "32",
    "COMMUNITY_RATE_MINUTE": "1",
    "COMMUNITY_RATE_HOUR": "5",
    "COMMUNITY_RATE_DAY": "15",
    "GITHUB_CARD_ENABLED": "true",
    "COMMUNITY_GITHUB_CACHE_TTL_HOURS": "24",
    "TRANSLATION_ENABLED": "true",
    "COMMUNITY_TRANSLATION_LOCALES": "en,zh,ja,es,fr",
    "TRANSLATION_TIMEOUT_MS": "15000",
    "TURNSTILE_SITE_KEY": "",
    "COMMUNITY_AGENT_ENABLED": "false",
    "COMMUNITY_AGENT_MAX_PER_RUN": "3",
    "COMMUNITY_AGENT_MAX_PER_DAY": "8",
    "GAMBIT_SOURCE_REGISTRY_JSON": "",
    // The audited production role budgets, written out explicitly rather than
    // left empty. An empty value silently falls back to `DEFAULT_ROLE_CONFIG`,
    // whose analysis (2,400) and critic (1,800) budgets are BELOW what a
    // reasoning-emitting model needs -- the exact N6 configuration mismatch
    // Phase 1.5/1.6 measured. `tests/open-gambit-role-budget.test.ts` pins these
    // numbers against the code's own 8,000-token clamp.
    //
    // `timeoutMs` is pinned at 30,000 for every non-translation role because
    // that IS the code clamp: Phase 1.7 T1 measured successful critic calls up
    // to 29.7s, so a larger value cannot be expressed and a larger token budget
    // would collide with the deadline before it helped.
    "GAMBIT_MODEL_ROLES_JSON": "{\"triage\":{\"timeoutMs\":30000,\"tokenBudget\":2400},\"gambit_analysis\":{\"timeoutMs\":30000,\"tokenBudget\":8000},\"critic\":{\"timeoutMs\":30000,\"tokenBudget\":6000},\"translation\":{\"timeoutMs\":60000,\"tokenBudget\":4000}}",
    "GAMBIT_LLM_PROVIDER": "",
    "GAMBIT_LLM_BASE_URL": "",
    "GAMBIT_LLM_MODEL": "",
    "GAMBIT_CRON_WINDOWS": "30 2 * * *,30 14 * * *",
    "GAMBIT_SCHEDULE_ENABLED": "false",
    "GAMBIT_CONFIG_VERSION": "0021_open_gambit",
    "GAMBIT_LOCAL_MEMORY_SNAPSHOTS": "true",
    "GAMBIT_MAX_SOURCES_PER_RUN": "20",
    // Global Top-K for expensive analysis, over the whole ranked pool -- never
    // per source. Written explicitly because it is the run-wide bound that
    // multiplies the per-candidate ceiling below.
    "GAMBIT_MAX_ANALYSIS_CANDIDATES_PER_RUN": "3",
    "GAMBIT_MAX_LLM_CALLS_PER_RUN": "12",
    // Worst case for one candidate (one fresh Workflow budget) with the role
    // budgets above: triage 2,400 x2 + analysis 8,000 x2 + critic 6,000 x2 (the
    // Phase 1.7 T2 bounded critic OPERATIONAL re-sample) = 32,800 tokens /
    // 6 calls, against a best case of 16,400 / 3 calls. The ceiling must cover
    // the WORST case, not the best one, because `consume()` charges the declared
    // budget before each attempt. 33,000 is the smallest round number that
    // covers 32,800.
    "GAMBIT_MAX_LLM_TOKENS_PER_RUN": "33000",
    // Translation has its own fail-closed quota, declared explicitly rather than
    // left to the code default so a future change to `gambitBudgetFromEnv()`
    // cannot silently move this bound. Measured worst case for one Workflow is
    // 4 locales x 2 attempts x the 2,000-token translation role budget = 8 calls
    // / 16,000 tokens.
    "GAMBIT_MAX_TRANSLATION_LLM_CALLS_PER_RUN": "8",
    "GAMBIT_MAX_TRANSLATION_LLM_TOKENS_PER_RUN": "32000",
    "GAMBIT_MAX_SEARCH_REQUESTS_PER_RUN": "6",
    "GAMBIT_MAX_X_REQUESTS_PER_RUN": "6",
    "GAMBIT_MAX_GITHUB_REQUESTS_PER_RUN": "6",
    "GAMBIT_MAX_HTTP_REQUESTS_PER_RUN": "20",
    // Byte cap for a fetched HTML page. Feeds are governed by
    // GAMBIT_MAX_FEED_BYTES instead: an atom <content> element may embed fully
    // rendered HTML, so one release note measured 172,048 bytes against a
    // 19,880-character payload and was dropped as SOURCE_TOO_LARGE.
    "GAMBIT_MAX_SOURCE_BYTES": "128000",
    // Byte cap for a fetched feed document (a source with a feedUrl).
    "GAMBIT_MAX_FEED_BYTES": "512000",
    "GAMBIT_HTTP_TIMEOUT_MS": "8000"
    // COMMUNITY_AGENT_SECRET is a server-side secret. Set it with
    // `wrangler secret put COMMUNITY_AGENT_SECRET` (or in .dev.vars for local).
    // It must never be committed or shipped to the browser bundle.
    // GAMBIT_LLM_API_KEY and GAMBIT_ADMIN_TOKEN are also server-side secrets;
    // set them through local secret storage or Wrangler secrets, never here.
  }
}
